# Staging — copy to docker/.env.staging before deploy
# Usage: ./scripts/deploy-staging.sh

COMPOSE_PROJECT_NAME=lladlad-staging
SPRING_PROFILES_ACTIVE=staging

# Staging subdomain (separate from production)
SITE_URL=https://staging.yourdomain.com
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com

DOMAIN=staging.yourdomain.com
LETSENCRYPT_DOMAIN=staging.yourdomain.com
CERTBOT_EMAIL=you@yourdomain.com

# MySQL (staging stack — separate volume from prod)
MYSQL_ROOT_PASSWORD=change-me-staging-root
MYSQL_DATABASE=blogdb_staging
MYSQL_USER=lladlad_staging
MYSQL_PASSWORD=change-me-staging-db

JWT_SECRET=change-me-staging-jwt-secret-at-least-256-bits
JWT_EXPIRATION=86400000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Non-standard ports so staging + prod can run on the same VPS
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Staging subdomain cert only (no www.staging)
CERTBOT_INCLUDE_WWW=false
