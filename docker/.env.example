# Production — copy to docker/.env before deploy
# Usage: ./scripts/deploy.sh

COMPOSE_PROJECT_NAME=lladlad-prod
SPRING_PROFILES_ACTIVE=prod

# Public site URL (React build + CORS + SSL)
SITE_URL=https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com

# DNS / Let's Encrypt
DOMAIN=yourdomain.com
LETSENCRYPT_DOMAIN=yourdomain.com
CERTBOT_EMAIL=you@yourdomain.com

# MySQL (prod stack — isolated volume)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=blogdb
MYSQL_USER=lladlad
MYSQL_PASSWORD=change-me-db

# Backend
JWT_SECRET=change-me-to-a-long-random-string-at-least-256-bits
JWT_EXPIRATION=86400000

# Optional
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Host ports (prod uses standard 80/443)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Production cert includes www
CERTBOT_INCLUDE_WWW=true
